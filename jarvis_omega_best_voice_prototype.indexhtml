<!doctype html>
<html lang="tr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#070b16"><title>JARVIS Ω — Voice Control</title>
<style>
:root{color-scheme:dark;--bg:#070b16;--panel:#101a2b;--line:#263e5c;--cyan:#6cecff;--muted:#a9bad0;--white:#eff8ff;--red:#ff788c;--green:#75f0b0;--gold:#ffd27a}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -10%,#1c4268 0%,var(--bg) 55%);color:var(--white);font-family:system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}main{max-width:820px;margin:auto;padding:18px 15px 34px}.top{display:flex;justify-content:space-between;align-items:center;gap:10px}.brand{font-size:1.08rem;letter-spacing:.16em;font-weight:850}.pill{font-size:.72rem;color:var(--green);border:1px solid #28634e;border-radius:999px;padding:7px 10px}.hero{text-align:center;padding:27px 0 18px}.orb{width:136px;height:136px;margin:0 auto 18px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle,#2b6889,#10243e 48%,#091323 75%);border:1px solid #55c9ef;box-shadow:0 0 25px #30c9ff44,inset 0 0 25px #38d8ff35;position:relative}.orb:before,.orb:after{content:"";position:absolute;inset:-10px;border:1px solid #48cfff66;border-radius:50%;animation:spin 14s linear infinite}.orb:after{inset:-19px;border-style:dashed;animation-direction:reverse;animation-duration:25s}.orb.listening{box-shadow:0 0 45px #ff788c66;border-color:var(--red)}.orb.speaking{box-shadow:0 0 45px #6cecff88}.orb span{font-size:2.6rem;font-weight:900;color:var(--cyan)}h1{font-size:1.55rem;margin:0 0 8px}.muted{color:var(--muted);line-height:1.55}.small{font-size:.83rem}.panel{background:#0d1727ef;border:1px solid var(--line);border-radius:18px;padding:15px;margin:13px 0;box-shadow:0 10px 35px #0002}.label{font-size:.78rem;letter-spacing:.08em;color:var(--cyan);font-weight:800;margin-bottom:9px}.row{display:flex;gap:9px;flex-wrap:wrap}.row>*{flex:1;min-width:100px}.btn{border:1px solid #37617e;background:#142941;color:var(--white);padding:12px 13px;border-radius:12px;font-weight:750;cursor:pointer;min-height:45px;font:inherit;font-size:.92rem}.btn.primary{background:linear-gradient(120deg,#1e7594,#2150a2);border-color:#6cecff}.btn.stop{border-color:#814b5a;background:#381c2b}.field{width:100%;border:1px solid var(--line);background:#08111e;color:var(--white);padding:13px;border-radius:12px;font:inherit;outline:none}.diag{font-size:.88rem;padding:12px;border-radius:10px;background:#091321;border:1px solid var(--line);margin-top:10px;white-space:pre-wrap;overflow-wrap:anywhere}.ok{color:var(--green)}.warn{color:var(--gold)}.err{color:var(--red)}.chat{display:flex;flex-direction:column;gap:10px;max-height:350px;overflow:auto;margin:10px 0}.msg{padding:11px 13px;border-radius:13px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}.user{align-self:flex-end;background:#173c5a;max-width:92%}.jarvis{align-self:flex-start;background:#142033;border:1px solid #243b58;max-width:96%}.tag{font-size:.7rem;color:var(--cyan);display:block;margin-bottom:4px;font-weight:800}.tips{padding-left:20px}.tips li{margin:7px 0;color:var(--muted);line-height:1.5}.grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.metric{background:#091321;border:1px solid var(--line);border-radius:12px;padding:11px}.metric b{display:block;font-size:.85rem;margin-bottom:4px}.metric span{font-size:.8rem;color:var(--muted)}footer{text-align:center;color:#72869f;font-size:.74rem;padding:12px}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:480px){.grid{grid-template-columns:1fr}.orb{width:120px;height:120px}}@media(prefers-reduced-motion:reduce){*{animation:none!important}}
</style></head><body><main>
<header class="top"><div class="brand">JARVIS <span style="color:var(--cyan)">Ω</span></div><div class="pill" id="status">SİSTEM HAZIR</div></header>
<section class="hero"><div class="orb" id="orb"><span>Ω</span></div><h1>Voice Control Center</h1><p class="muted">Konuş. Yaz. Yanıtı dinle. Mikrofon sorununu teşhis et.</p><p class="small muted">Telefon için tasarlanmış ücretsiz arayüz prototipi.</p></section>
<section class="panel"><div class="label">SİSTEM DURUMU</div><div class="grid">
<div class="metric"><b>Güvenli bağlantı</b><span id="secureMetric">Kontrol ediliyor…</span></div><div class="metric"><b>Konuşma tanıma</b><span id="speechMetric">Kontrol ediliyor…</span></div><div class="metric"><b>Sesli okuma</b><span id="ttsMetric">Kontrol ediliyor…</span></div><div class="metric"><b>Mikrofon izni</b><span id="permissionMetric">Kontrol edilecek</span></div></div>
<div id="diag" class="diag" role="status" aria-live="polite">Hazır. Sistem durumunu kontrol et.</div><div class="row" style="margin-top:10px"><button class="btn primary" id="micBtn">🎙 Konuşmaya başla</button><button class="btn" id="checkBtn">↻ Durumu kontrol et</button></div></section>
<section class="panel"><div class="label">SOHBET</div><div class="chat" id="chat" aria-live="polite"><div class="msg jarvis"><span class="tag">JARVIS Ω</span>Merhaba. Mikrofon testi için “Merhaba Jarvis” diyebilirsin. Mikrofon çalışmazsa mesajını yaz.</div></div><form id="form"><input id="message" class="field" placeholder="Mesajını yaz…" autocomplete="off" aria-label="JARVIS mesajı"><div class="row" style="margin-top:9px"><button class="btn primary" type="submit">Gönder</button><button class="btn" type="button" id="readBtn">🔊 Yanıtı oku</button><button class="btn" type="button" id="stopVoiceBtn">■ Sesi durdur</button></div></form></section>
<section class="panel"><div class="label">MİKROFON ÇALIŞMIYORSA</div><ol class="tips"><li>Dosyayı doğrudan telefondan açmak yerine bir <b>HTTPS</b> sayfasından aç. Yerel <code>file://</code> dosyalarında mikrofon engellenebilir.</li><li>Chrome → Ayarlar → Site ayarları → Mikrofon bölümünden izinleri kontrol et. Sayfa izin sorarsa “İzin ver” seç.</li><li>Android uygulama izinlerinde Chrome'un mikrofon erişiminin açık olduğuna bak.</li><li>“not-allowed” izin; “audio-capture” mikrofon aygıtı; “network” konuşma tanıma servisi/ağ hatasına işaret edebilir.</li><li>Chrome/cihaz Web Speech API'yi desteklemiyorsa HTTPS ve izin yeterli olmayabilir. Yazıyla sohbet yine kullanılabilir.</li></ol></section>
<section class="panel"><div class="label">ŞEFFAF SINIRLAR</div><p class="small muted">Bu sürüm tarayıcının konuşma tanıma ve sesli okuma özelliklerini test eder. Yanıtlar örnek yanıtlarla oluşturulur; henüz gerçek bir yapay zekâ servisine bağlı değildir ve telefonun diğer uygulamalarını kontrol etmez.</p></section>
<footer>JARVIS Ω · Voice Prototype 1.0 · Ücretsiz prototip</footer></main>
<script>
(()=>{const $=id=>document.getElementById(id),Recognition=window.SpeechRecognition||window.webkitSpeechRecognition;let rec=null,listening=false,lastReply="Sesli okuma testi tamamlandı.";
function setDiag(s,k=""){$("diag").className="diag "+k;$("diag").textContent=s}
function msg(text,who){const d=document.createElement("div");d.className="msg "+who;const t=document.createElement("span");t.className="tag";t.textContent=who==="user"?"SEN":"JARVIS Ω";d.append(t,document.createTextNode(text));$("chat").append(d);$("chat").scrollTop=$("chat").scrollHeight}
function diagnose(){const secure=window.isSecureContext===true;$("secureMetric").textContent=secure?"Evet":"Hayır — HTTPS gerekebilir";$("secureMetric").className=secure?"ok":"warn";$("speechMetric").textContent=Recognition?"API mevcut":"API bulunamadı";$("speechMetric").className=Recognition?"ok":"warn";$("ttsMetric").textContent=("speechSynthesis"in window)?"Mevcut":"Bulunamadı";$("ttsMetric").className=("speechSynthesis"in window)?"ok":"warn";
if(navigator.permissions&&navigator.permissions.query)navigator.permissions.query({name:"microphone"}).then(p=>{$("permissionMetric").textContent=p.state==="granted"?"İzin verildi":p.state==="denied"?"Engellendi":"İzin sorulabilir";$("permissionMetric").className=p.state==="granted"?"ok":p.state==="denied"?"err":"warn"}).catch(()=>{$("permissionMetric").textContent="Chrome'dan kontrol et"});else $("permissionMetric").textContent="Chrome'dan kontrol et";
if(!secure)setDiag("Bu sayfa güvenli bağlamda çalışmıyor. Mikrofon için HTTPS adresi gerekebilir. Yerel HTML dosyalarında tarayıcı mikrofonu engelleyebilir.","warn");else if(!Recognition)setDiag("Güvenli bağlantı var ancak konuşma tanıma API'si bulunamadı. Chrome'u güncelle; cihaz bu özelliği desteklemeyebilir. Yazı girişi kullanılabilir.","warn");else setDiag("Temel kontroller tamamlandı. “Konuşmaya başla” düğmesine dokun ve Chrome mikrofon iznini ver.","ok")}
function answer(s){const t=s.toLocaleLowerCase("tr-TR");if(/merhaba|selam|hello/.test(t))return "Merhaba! JARVIS Ω ses arayüzü çalışıyor. Bu prototipte gerçek yapay zekâ bağlantısı henüz yok.";if(/mikrofon|sesim|duyuyor/.test(t))return "Mikrofon için HTTPS, Chrome izni ve cihazda konuşma tanıma desteği gerekir. Durum panelindeki hata mesajını kontrol et.";if(/kimsin|adın/.test(t))return "Ben JARVIS Ω arayüz prototipiyim. Şu anda ses ve metin akışını test ediyorum; tam yetenekli bir yapay zekâ asistanı değilim.";if(/saat|tarih/.test(t))return "Cihaz tarih ve saati: "+new Date().toLocaleString("tr-TR")+".";if(/yardım|komut|ne yapabilirsin/.test(t))return "Şimdilik metin alabilir, bazı yerel test yanıtları verebilir ve yanıtı tarayıcıya okutabilirim. Dış uygulamalara erişim ve gerçek AI bağlantısı henüz eklenmedi.";return "Mesajını aldım: “"+s+"”. Bu prototipte gerçek AI modeli bağlı olmadığı için yanıtlarım sınırlı."}
function speak(s){if(!("speechSynthesis"in window)){setDiag("Bu tarayıcı sesli okumayı desteklemiyor.","warn");return}speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(s);u.lang="tr-TR";u.rate=1;u.pitch=1;u.onstart=()=>{$("orb").classList.add("speaking");$("status").textContent="KONUŞUYOR"};u.onend=()=>{$("orb").classList.remove("speaking");$("status").textContent=listening?"DİNLİYOR":"SİSTEM HAZIR"};u.onerror=()=>{ $("orb").classList.remove("speaking");setDiag("Sesli yanıt başlatılamadı. Telefonun medya sesini kontrol et.","warn")};speechSynthesis.speak(u)}
function send(s){s=(s||"").trim();if(!s)return;msg(s,"user");lastReply=answer(s);msg(lastReply,"jarvis");$("message").value=""}
function start(){if(!Recognition){setDiag("Bu tarayıcıda konuşma tanıma API'si yok. HTTPS tek başına bunu garanti etmez; yazıyla kullanabilirsin.","err");return}if(!window.isSecureContext){setDiag("Mikrofon güvenlik nedeniyle engellenebilir. Dosyayı HTTPS adresinden açıp tekrar dene.","err");return}try{rec=new Recognition();rec.lang="tr-TR";rec.interimResults=true;rec.continuous=false;rec.maxAlternatives=1;let final="";
rec.onstart=()=>{listening=true;$("micBtn").textContent="⏹ Dinlemeyi durdur";$("micBtn").classList.add("stop");$("orb").classList.add("listening");$("status").textContent="DİNLİYOR";setDiag("Dinliyorum… Şimdi konuş.","ok")};
rec.onresult=e=>{let interim="";for(let i=e.resultIndex;i<e.results.length;i++){const x=e.results[i][0].transcript;if(e.results[i].isFinal)final+=x;else interim+=x}setDiag("Algılanan konuşma: "+(final+" "+interim).trim(),"ok")};
rec.onerror=e=>{let s="Konuşma hatası: "+e.error+".";if(e.error==="not-allowed"||e.error==="service-not-allowed")s+=" Chrome mikrofon iznini kontrol et.";if(e.error==="audio-capture")s+=" Mikrofon bulunamadı veya başka uygulama kullanıyor.";if(e.error==="network")s+=" Konuşma tanıma servisi ağ bağlantısı isteyebilir.";if(e.error==="no-speech")s+=" Konuşma algılanmadı; tekrar dene.";setDiag(s,"err")};
rec.onend=()=>{listening=false;$("micBtn").textContent="🎙 Konuşmaya başla";$("micBtn").classList.remove("stop");$("orb").classList.remove("listening");$("status").textContent="SİSTEM HAZIR";if(final.trim()){send(final.trim());speak(lastReply)}};rec.start()}catch(e){setDiag("Mikrofon başlatılamadı: "+(e.message||e),"err")}}
$("micBtn").addEventListener("click",()=>{if(listening&&rec){rec.stop();return}start()});$("checkBtn").addEventListener("click",diagnose);$("form").addEventListener("submit",e=>{e.preventDefault();send($("message").value)});$("readBtn").addEventListener("click",()=>speak(lastReply));$("stopVoiceBtn").addEventListener("click",()=>{if("speechSynthesis"in window)speechSynthesis.cancel();$("orb").classList.remove("speaking");$("status").textContent=listening?"DİNLİYOR":"SİSTEM HAZIR"});diagnose()})();
</script></body></html>
